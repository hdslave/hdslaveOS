build/
# .local holds working files. Kept in the repository: the audit's sources (optimization.md is made from them by
# .local/audit/build_doc.py) and the scripts that build, check and measure. Logs and profiler output stay out.
.local/*
!.local/audit/
!.local/checks/
!.local/profiler/
!.local/*.sh
!.local/prof/
.local/prof/*
!.local/prof/*.py
__pycache__/
*.py[cod]
*.so
*.o
*.wav
*.png
# Doc pages' screenshots and diagrams are tracked (base/tools/check_private_files.py allows them).
!docs/images/**/*.png
*.log
.DS_Store
.env*
*.key
*.pem
*ed25519*
known_hosts*
projects/
captures/
backups/
.ssh/
private/
*.xpj
*.xpm
*.xps
*.bin
*.img
*.raw
*.pcm
*.zip
*.tar
*.gz
*.aif
*.aiff
*.settings
!/AGENTS.md
dist/

# The quickstart's screenshots (rendered by --melodee-preview)
!/docs/images/quickstart/*.png
